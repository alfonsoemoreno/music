{
  "name": "digital-album-companion",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": { "node": ">=24 <25", "pnpm": ">=10" },
  "scripts": {
    "dev": "pnpm --parallel --filter @music/web --filter @music/wiim-agent dev",
    "web:dev": "pnpm --filter @music/web dev",
    "agent:dev": "pnpm --filter @music/wiim-agent dev",
    "agent:start": "pnpm --filter @music/wiim-agent start",
    "build": "pnpm -r build",
    "build:verify": "NEXT_DIST_DIR=.next-verify pnpm --filter @music/web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @music/web db:generate",
    "db:migrate": "pnpm --filter @music/web db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
