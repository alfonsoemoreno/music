# Cloud (apps/web/.env.local)
DATABASE_URL=
AGENT_TOKEN_PEPPER=
DISCOGS_TOKEN=
LASTFM_API_KEY=
FANARTTV_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MUSICBRAINZ_APP_NAME=DigitalAlbumCompanion
MUSICBRAINZ_CONTACT=
AUTH_SECRET=
# Optional browser-only local WiiM bridge. It lets a tablet browser poll its own LAN
# while this tab stays open; it never exposes AGENT_TOKEN to the browser.
BROWSER_ACCESS_CODE=
BROWSER_SESSION_SECRET=

# Agent (apps/wiim-agent/.env)
CLOUD_API_URL=http://localhost:3000
AGENT_TOKEN=
# Optional fallback only. The agent discovers WiiM automatically.
WIIM_HOST=
WIIM_DISCOVERY=true
PLAYBACK_POLL_INTERVAL=2000
LOCAL_STATUS_PORT=3847
# Optional override only for Docker or an unusual network. Normally detected automatically.
LOCAL_ARTWORK_BASE_URL=
